/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include <stdlib.h>
#include <xtime_l.h> // Timer for execution time calculations
#include "platform.h"
#include "xil_printf.h"

#define FIR_Size 5 // FIR Filter Size
#define FIR_Data_Size 6 // Size of input and output

const int FIR_COEFF[FIR_Size] = {1, 2, 6, 2, 1}; // Filter Coefficients

// FIR Filter Implementation in PS
void FIR_PS_Direct(int FIR_input[FIR_Data_Size], int FIR_output[FIR_Data_Size])
{
    int index1, index2;
    int shift_reg[FIR_Size] = {0, 0, 0, 0}; // Initialize shift register to 0
    for (index1 = 0; index1 < FIR_Data_Size; index1++)
    {
        for (index2 = 0; index2 < FIR_Size; index2++)
        {
            // For every input, update the shift register
            shift_reg[FIR_Size - index2 - 1] = shift_reg[FIR_Size - index2 - 2];
        }
        shift_reg[0] = FIR_input[index1]; // First input enters inside the shift register
        FIR_output[index1] = 0; // For MAC operation, initialize output to 0
        for (index2 = 0; index2 < FIR_Size; index2++)
        {
            // Filter MAC operation
            FIR_output[index1] += shift_reg[index2] * FIR_COEFF[index2];
        }
    }
}


int main()
{
    init_platform();
    // Define input and output vectors for FIR Filter
    int FIR_input[FIR_Data_Size], FIR_output[FIR_Data_Size];
    int index;
    // to store the time at which certain processes starts and ends
    XTime time_PS_start, time_PS_end;
    // Initialize the input..you may use random numbers as well.
    for (index = 0; index < FIR_Data_Size; index++)
    {
        FIR_input[index] = index + 1;
    }
    // Initialize the time to 0
    XTime_SetTime(0);
    XTime_GetTime(&time_PS_start); // Capture the timer value before calling FIR filter
    FIR_PS_Direct(FIR_input, FIR_output); // Call PS implementation of FIR
    XTime_GetTime(&time_PS_end); // Capture the timer value at the end of FIR filter

    // Print the FIR output on the UART
    printf("\n FIR output: \n");
    for (index = 0; index < FIR_Data_Size; index++)
    {
        printf("%d\n", FIR_output[index]);
    }

    printf("\n-------------EXECUTION TIME-----------------------\n");
    float time_processor = 0;
    time_processor = (float)1.0 * (time_PS_end - time_PS_start) / (COUNTS_PER_SECOND / 1000000);
    printf("Execution Time for PS in Micro-Seconds: %f\n", time_processor);
    cleanup_platform();
    return 0;
}
