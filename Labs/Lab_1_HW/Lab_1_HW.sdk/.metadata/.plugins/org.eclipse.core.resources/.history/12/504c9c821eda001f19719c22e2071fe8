/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */


#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"
#include "math.h"

int main()
{
    init_platform();

    	float X[3], N[3], T[3], Q[3];
        int i;

        printf("\nVector X Values: \n");
        for(i=0; i<3; i++)
        {
            printf("Enter value X[%d]: ", i);
            scanf("%f", &X[i]);
        }

        printf("\nVector N Values: \n");
        for(i=0; i<3; i++) {
            printf("Enter value N[%d]: ", i);
            scanf("%f", &N[i]);
        }

        printf("\nVector T Values: \n");
        for(i=0; i<3; i++) {
            printf("Enter value T[%d]: ", i);
            scanf("%f", &T[i]);
        }

        for(i=0; i<3; i++) {
        	Q[i] = (X[i]/T[i]) + sqrt((2*N[i])/T[i]);
        }


        printf("\n*******************************");
        printf("\nOutput Vector Q is: \n");
        for(i=0; i<3; i++) {
            printf("Q[%d]: %.2f\t", i, Q[i]);
        }
        printf("\n*******************************\n\r");

    cleanup_platform();
    return 0;
}


