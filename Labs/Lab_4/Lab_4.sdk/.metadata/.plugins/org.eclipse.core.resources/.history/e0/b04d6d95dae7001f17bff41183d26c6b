/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include <stdlib.h>
#include <complex.h>
#include <xtime_l.h> // Timer for execution time calculations
#include "platform.h"
#include "xil_printf.h"
#include "xaxidma.h"
#include "xparameters.h"


#define FIR_Size 21			// Fir Filter Size 21
#define FIR_Data_Size 30	// Input Data Size 30

// FIR filter coefficients taken from Matlab
const int FIR_COEFF[FIR_Size] = {13, 12, 9, 2, 0, 13, 50, 110, 179, 234, 255, 234, 179, 110, 50, 13, 0, 2, 9, 12, 13};

// I have implemented 3 functions for FIR, functions FIR_PS_Direct and FIR_PS_Direct1 is taken from Lab2 for Unoptimized and Bit-optimized FIR, and third function FIR_PS_DirectCGTPSym is taken from Lab4 for symmetric FIR

// Unoptimized FIR
void FIR_PS_Direct(int FIR_input[FIR_Data_Size], int FIR_output[FIR_Data_Size])
{
    int index1, index2;
    int shift_reg[FIR_Size];

    for (index1 = 0; index1 < FIR_Size; index1++) {
        shift_reg[index1] = 0;		// Initialize shift register with zeros
    }

    for (index1 = 0; index1 < FIR_Data_Size; index1++) {
    	// Shift register logic
        for (index2 = FIR_Size - 1; index2 > 0; index2--) {
            shift_reg[index2] = shift_reg[index2 - 1];
        }
        shift_reg[0] = FIR_input[index1];

        FIR_output[index1] = 0;		// Initialize output

        // Perform FIR filtering - MAC operation
        for (index2 = 0; index2 < FIR_Size; index2++) {
            FIR_output[index1] += shift_reg[index2] * FIR_COEFF[index2];
        }
    }
}

// Bit-optimized FIR
void FIR_PS_Direct1(int FIR_input[FIR_Data_Size], int FIR_output[FIR_Data_Size])
{
    int index1, index2;
    int shift_reg[FIR_Size];

    for (index1 = 0; index1 < FIR_Size; index1++) {
        shift_reg[index1] = 0;		// Initialize shift register with zeros
    }
    for (index1 = 0; index1 < FIR_Data_Size; index1++) {
        FIR_output[index1] = FIR_input[index1] * FIR_COEFF[0];		// Multiply first coefficient

        for (index2 = FIR_Size - 1; index2 > 0; index2--) {
            shift_reg[index2] = shift_reg[index2 - 1];				// Shift register logic
            FIR_output[index1] += shift_reg[index2] * FIR_COEFF[index2];	// MAC operation
        }
        shift_reg[0] = FIR_input[index1];
    }
}

// Symmetric FIR
void FIR_PS_DirectCGTPSym(int FIR_input[FIR_Data_Size], int FIR_output[FIR_Data_Size]) {
    // Loop over each sample of the input
    for (int i_data = 0; i_data < FIR_Data_Size; i_data++) {
        FIR_output[i_data] = 0; // Initialize the output

        // Apply the FIR filter (convolution sum)
        for (int i_coef = 0; i_coef <= FIR_Size / 2; i_coef++) {
            if (i_data - i_coef>= 0) {
                FIR_output[i_data] += FIR_input[i_data - i_coef] * FIR_COEFF[i_coef];
            }
            if (i_data - (FIR_Size - i_coef - 1) >= 0 && i_coef != FIR_Size - i_coef - 1) {
                FIR_output[i_data] += FIR_input[i_data - (FIR_Size - i_coef - 1)] * FIR_COEFF[i_coef];
            }
        }
    }
}

// Compare different FIR implementations
void comp_PSvsACP()
{
	int FIR_input[FIR_Data_Size];
	int FIR_PS_Unopt_Output[FIR_Data_Size], FIR_PS_BitOpt_Output[FIR_Data_Size], FIR_PS_SymOpt_Output[FIR_Data_Size], FIR_PL_Output[FIR_Data_Size];

	int index;

	// Initialize input data
	for (index=0;index<FIR_Data_Size;index++)
	{
		FIR_input[index] = index+1;
	}

	 // Measure execution time for Unoptimized FIR on PS
	XTime PS_Start_Unopt, PS_End_Unopt;						// Variables used to store values whose datatype is XTime which is 64 bit unsigned value to store time
	XTime_SetTime(0);										// Reset upcounter value to 0 using setter function
	XTime_GetTime(&PS_Start_Unopt);							// Capture timer value at the start
	FIR_PS_Direct(FIR_input, FIR_PS_Unopt_Output);			// Execute unoptimized FIR
	XTime_GetTime(&PS_End_Unopt);							// Capture timer value at the end

	 // Measure execution time for Bit-Optimized FIR on PS
	XTime PS_Start_BitOpt, PS_End_BitOpt;					// Variables used to store values whose datatype is XTime which is 64 bit unsigned value to store time
	XTime_SetTime(0);										// Reset upcounter value to 0 using setter function
	XTime_GetTime(&PS_Start_BitOpt);						// Capture timer value at the start
	FIR_PS_Direct1(FIR_input, FIR_PS_BitOpt_Output);		// Execute Bit-Optimized FIR
	XTime_GetTime(&PS_End_BitOpt);							// Capture timer value at the end

	 // Measure execution time for Symmetric FIR on PS
	XTime PS_Start_SymOpt, PS_End_SymOpt;					// Variables used to store values whose datatype is XTime which is 64 bit unsigned value to store time
	XTime_SetTime(0);										// Reset upcounter value to 0 using setter function
	XTime_GetTime(&PS_Start_SymOpt);						// Capture timer value at the start
	FIR_PS_DirectCGTPSym(FIR_input, FIR_PS_SymOpt_Output);	// Execute Bit-Optimized FIR
	XTime_GetTime(&PS_End_SymOpt);							// Capture timer value at the end

	// DMA Configuration

	int status;
	XAxiDma_Config *DMA_Config;		// Pointer to DMA configuration structure
	XAxiDma DMA_instance;			// DMA instance

	DMA_Config = XAxiDma_LookupConfig(XPAR_AXI_DMA_0_DEVICE_ID);		// This will copy all the configuration info from .h file to our config pointer.
	status = XAxiDma_CfgInitialize(&DMA_instance,DMA_Config);			// Initialize DMA by setting up the registers and ensure that the hardware is in proper state.

	// Check if DMA initialization was successful
	if(status != XST_SUCCESS)
	{
		printf("DMA Configuration failed.\t\n");
	    return 0;
	}

	// Measure execution time for PL
	XTime PL_Start, PL_End;									// Variables used to store values whose datatype is XTime which is 64 bit unsigned value to store time
	XTime_SetTime(0);										// Reset upcounter value to 0 using setter function
	XTime_GetTime(&PL_Start);								// Capture timer value at the start

	/* FIR is so fast that while the DMA is sending the first bunch of data FIR might have calculated the output and it will start sending the data to the DMA, if DMA isn't ready to accept, then
	 * FIR IP will put the back pressure on the DMA and the IP won't accept the data from DMA*/
	status= XAxiDma_SimpleTransfer(&DMA_instance, (UINTPTR) FIR_PL_Output, FIR_Data_Size*sizeof(int),XAXIDMA_DEVICE_TO_DMA); 	// Tell the DMA first be ready to accept the data from FIR
	status= XAxiDma_SimpleTransfer(&DMA_instance, (UINTPTR) FIR_input, FIR_Data_Size*sizeof(int),XAXIDMA_DMA_TO_DEVICE); 		// Then send the data from DMA to FIR

	status = XAxiDma_ReadReg(XPAR_AXI_DMA_0_BASEADDR,0x04)&0x00000002;				// We are checking if the second last bit is high or not, to check if DMA is IDLE or BUSY.

	// Then using while loop we can check when the task is finished, whenever DMA is Idle, i.e. second last bit is high
	while(status != 0x00000002)
	{
		status = XAxiDma_ReadReg(XPAR_AXI_DMA_0_BASEADDR,0x04)&0x00000002;
	}

	status = XAxiDma_ReadReg(XPAR_AXI_DMA_0_BASEADDR,0x34)&0x00000002;
	while(status != 0x00000002)
	{
		status = XAxiDma_ReadReg(XPAR_AXI_DMA_0_BASEADDR,0x34)&0x00000002;
	}

	XTime_GetTime(&PL_End);							// Capture timer value at the end

	// Compare Outputs from PS and PL
	int j;
	int err_flag = 0; //error flag to check for mismatch between PS and PL data

	for (j = 0 ; j < FIR_Data_Size ; j++)
	   {
		  // Check for data mismatch between PS and PL implementations
			if ((abs(FIR_PS_Unopt_Output[j] - FIR_PL_Output[j]) >= 1) &&
				(abs(FIR_PS_BitOpt_Output[j] - FIR_PL_Output[j]) >= 1) &&
				(abs(FIR_PS_SymOpt_Output[j] - FIR_PL_Output[j]) >= 1))
			{

				err_flag = 1;		// Set error flag if mismatch is found
				break;				 // Exit loop on the mismatch
			}

			// Print results for comparison
		   printf("PS Unoptimized: %d \n",FIR_PS_Unopt_Output[j]);
		   printf("PS Bit Optimized: %d \n",FIR_PS_BitOpt_Output[j]);
		   printf("PS Symmetric Opt: %d \n",FIR_PS_SymOpt_Output[j]);
		   printf("PL: %d \n",FIR_PL_Output[j]);
	   }
	  if(err_flag==1)
	  	printf("Data Mismatch found at %d output \r\n",j);		// Print error message if data mismatch is found
	  else
		printf("No Data Mismatch\r\n");

	// Print Execution Time Results
	printf("\n-----------EXECUTION TIME--------------------\n");
	float time_processor_Unopt = 0, time_processor_BitOpt = 0, time_processor_SymOpt = 0;
	float time_FPGA = 0;

	time_processor_Unopt = (float)1.0 * (PS_End_Unopt - PS_Start_Unopt) / (COUNTS_PER_SECOND/1000000);			/* Global Timer COUNTS_PER_SECOND is always clocked at half of the CPU frequency */
	time_processor_BitOpt = (float)1.0 * (PS_End_BitOpt - PS_Start_BitOpt) / (COUNTS_PER_SECOND/1000000);		// COUNTS_PER_SECOND = 650 MHz / 2
	time_processor_SymOpt = (float)1.0 * (PS_End_SymOpt - PS_Start_SymOpt) / (COUNTS_PER_SECOND/1000000);
	time_FPGA = (float)1.0 * (PL_End - PL_Start) / (COUNTS_PER_SECOND/1000000);

    if (!err_flag)
        printf("No Data Mismatch\n");

    // Display Execution Times and Acceleration Factors
    printf("\n----------- EXECUTION TIME (Microseconds) --------------------\n");
    printf("PS Unoptimized       : %f\n", time_processor_Unopt);
    printf("PS Bit Optimized     : %f\n", time_processor_BitOpt);
    printf("PS Symmetric Opt     : %f\n", time_processor_SymOpt);
    printf("PL (DMA Execution)   : %f\n", time_FPGA);

    printf("\n----------- ACCELERATION FACTORS --------------------\n");
    printf("PL vs PS Unoptimized       : %f\n", time_processor_Unopt / time_FPGA);
    printf("PL vs PS Bit Optimized     : %f\n", time_processor_BitOpt / time_FPGA);
    printf("PL vs PS Symmetric Optimized : %f\n", time_processor_SymOpt / time_FPGA);

}

int main()
{
    init_platform();

    print("Hello World\n\r");
    comp_PSvsACP();

    cleanup_platform();
    return 0;
}
