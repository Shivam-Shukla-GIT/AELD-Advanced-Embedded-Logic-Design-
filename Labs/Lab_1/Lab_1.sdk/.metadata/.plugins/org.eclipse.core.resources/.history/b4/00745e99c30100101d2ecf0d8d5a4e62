void Receiver_Main(complex_t Tx_OTA_signal[TX_SIG_LEN], Result results) {

	// Function to start receiver and capture random 3000 samples
	static complex_t Rx_signal[PACKETS_CAPTURE_LEN];
	capture_data(Tx_OTA_signal, Rx_signal); // Capture 3000 samples

	// Applyig convolution between Recieved signal and RRC Filter
	static complex_t Rx_filter_signal[rrc_rc_out_len];
	rx_rrx_conv(Rx_signal,Rx_filter_signal);

	// Packet detection
	static data_t corr_out[corr_arr_len];
	packet_detection(Rx_signal, corr_out);

	// Packet selection and downsampling
	static complex_t rx_frame[FRAME_LENGTH];
	packet_selection_and_downsampling(rx_frame,corr_out,Rx_filter_signal);

	// Coarse CFO
	static complex_t rx_frame_after_coarse[FRAME_LENGTH];
	coarse_cfo_estimation(rx_frame, rx_frame_after_coarse);

	// Fine CFO
	static complex_t rx_frame_after_fine[FRAME_LENGTH];
	fine_cfo_estimation(rx_frame_after_coarse, rx_frame_after_fine);

	// Channel_estimation
	static complex_t H_est[N_FFT];
	channel_estimation(rx_frame_after_fine,H_est);

	// One_tap_equalizer
	static complex_t RX_Payload_1_Frequency_Equalizer[N_FFT];
	static complex_t RX_Payload_2_Frequency_Equalizer[N_FFT];
	one_tap_equalizer(rx_frame_after_fine, H_est, RX_Payload_1_Frequency_Equalizer,RX_Payload_2_Frequency_Equalizer);

	//Extract_payload 1
	static complex_t RX_Payload_1_no_pilot[SIZE];
	extract_payload(RX_Payload_1_Frequency_Equalizer, RX_Payload_1_no_pilot);

	//	Extract_payload 2
	static complex_t RX_Payload_2_no_pilot[SIZE];
	extract_payload(RX_Payload_2_Frequency_Equalizer, RX_Payload_2_no_pilot);

	// Output complex array for Payload 1
	static complex_t RX_Payload_1_Final[SIZE];
	AGC_Rx_Data_Payload(RX_Payload_1_no_pilot, RX_Payload_1_Final);

	// Output complex array for Payload 2
	static complex_t RX_Payload_2_Final[SIZE];
	AGC_Rx_Data_Payload(RX_Payload_2_no_pilot, RX_Payload_2_Final);

	// QPSK Demodulation for Payload 1
	static data_t RX_Payload_1_Demod[2 * SIZE];
	QPSK_Demodulate(RX_Payload_1_Final, RX_Payload_1_Demod);

	// QPSK Demodulation for Payload 2
	static data_t RX_Payload_2_Demod[2 * SIZE];
	QPSK_Demodulate(RX_Payload_2_Final, RX_Payload_2_Demod);

	// Calculate EVM before AGC
	results.evm = calculate_evm_agc(RX_Payload_1_no_pilot, RX_Payload_2_no_pilot, data_payload_1_mod, data_payload_2_mod);
//	printf("EVM Before AGC (dB):%f\n", results.evm);

	// Calculate EVM after AGC
	results.evm_AGC = calculate_evm_agc(RX_Payload_1_Final, RX_Payload_2_Final, data_payload_1_mod, data_payload_2_mod);
//	printf("EVM After AGC (dB):%f\n", results.evm_AGC);

	// Calculate BER
	results.ber = calculate_ber(data_payload_1, RX_Payload_1_Demod, data_payload_2,  RX_Payload_2_Demod);
//	printf("BER: %f\n\n", results.ber);
}

