void rx_rrx_conv(complex_t Rx_signal[PACKETS_CAPTURE_LEN],complex_t  Rx_filter_signal[rrc_rc_out_len]){

    for (int n = 0; n < rrc_rc_out_len; n++) {
    	Rx_filter_signal[n] = 0.0 + 0.0*I;
        for (int k = 0; k < RRC_FILTER_LENGTH; k++) {
        	int idx = n + k - (RRC_FILTER_LENGTH - 1);
        	if (idx >= 0 && idx < PACKETS_CAPTURE_LEN) {
        		Rx_filter_signal[n] += (rrc_filter_coff[k]+0.0*I) * Rx_signal[idx];
        	}
        }
    }
}

void packet_detection(complex_t Rx_signal[PACKETS_CAPTURE_LEN], data_t corr_out[corr_arr_len]){

    for (int n = 0; n < corr_arr_len; n++) {
    	complex_t temp1 = 0.0 + 0.0*I;
    	data_t temp2 = 0.0;
    	for (int k = 0; k < window_length; k++) {
    		temp1 += Rx_signal[n+k]*Rx_signal[n+k+delay_param];
    		temp2 += crealf(Rx_signal[n+k+delay_param] * conjf(Rx_signal[n+k+delay_param]));
    	}
    	corr_out[n] = (crealf(temp1 * conjf(temp1)))/(temp2*temp2);
    }
}

void packet_selection_and_downsampling(complex_t rx_frame[FRAME_LENGTH],data_t corr_out[corr_arr_len],complex_t Rx_filter_signal[rrc_rc_out_len]){

	data_t packet_threshold = 0.8;

	int temp_packet_idx_arr[corr_arr_len] = {0};
    int idx_count = 0;

    for (int i = 0; i < corr_arr_len; i++) {
        if (corr_out[i] > packet_threshold) {
        	temp_packet_idx_arr[idx_count] = i;
        	idx_count += 1;
        }
    }

    int packet_idx_arr[idx_count];

    for (int i = 0; i < idx_count; i++) {
        packet_idx_arr[i] = temp_packet_idx_arr[i];
    }

    int temp3[idx_count + 1];


    // Compute the first element
    temp3[0] = packet_idx_arr[0];

    // Compute differences for the middle elements
    for (int i = 1; i < idx_count; i++) {
    	temp3[i] = packet_idx_arr[i] - packet_idx_arr[i - 1];
    }
    // Compute the last element
    temp3[idx_count] = -packet_idx_arr[idx_count - 1];

    int temp_packet_front[idx_count+1];
    int packet_front_count = 0;
    for (int i = 0; i < idx_count+1; i++) {
    	if (temp3[i] > 300) {
    		temp_packet_front[packet_front_count] = i;
    		packet_front_count += 1;
        	}
    	else{
    		temp_packet_front[i] = 0;
    	}
        }
    int packet_front[packet_front_count];
    for (int i = 0; i < packet_front_count; i++) {
    	packet_front[i] = temp_packet_front[i];
    }

    int packet_front_idx[packet_front_count];
    for (int i = 0; i < packet_front_count; i++) {
        packet_front_idx[i] = packet_idx_arr[packet_front[i]];
    }

    int threshold_length = 230; // Minimum length of the packet
    int packet_idx = 0;
    for (int x = 0; x < packet_front_count - 1; x++) {
    	if (corr_out[packet_front_idx[x] + threshold_length] > packet_threshold) {
    		packet_idx = packet_front_idx[x] + length_rrc_rx + 1;  // Adjust for RRC filter delay
    		break;  // Exit loop once a valid packet is found
    		}
    }

    int end_idx = OVERSAMPLING_RATE * FRAME_LENGTH + packet_idx - 1;
    int j = 0;

    // Loop to extract values at the specified step
    for (int i = packet_idx; i <= end_idx; i += OVERSAMPLING_RATE) {
    	rx_frame[j++] = Rx_filter_signal[i];
        }
}


void coarse_cfo_estimation(complex_t rx_frame[FRAME_LENGTH], complex_t rx_frame_after_coarse[FRAME_LENGTH]) {
    int start1 = 5 * Short_preamble_slot_length;
    int start2 = 6 * Short_preamble_slot_length;

    // Compute the complex conjugate product
    complex_t prod_consq_frame_coarse = 0.0 + 0.0 * I;
    for (int i = 0; i < Short_preamble_slot_length; i++) {
        prod_consq_frame_coarse += rx_frame[start1 + i] * conjf(rx_frame[start2 + i]);
    }

    // Estimate the coarse frequency offset
    data_t freq_coarse_est = (-1.0 / (2.0 * M_PI * Short_preamble_slot_length * ts_sec)) *atan2f(cimagf(prod_consq_frame_coarse), crealf(prod_consq_frame_coarse));

    // Apply CFO correction to the received frame
    for (int i = 0; i < FRAME_LENGTH; i++) {
        data_t phase_shift = -2.0 * M_PI * freq_coarse_est * ts_sec * i;
        rx_frame_after_coarse[i] = rx_frame[i] * cexpf(I * phase_shift);
    }
}

void fine_cfo_estimation(complex_t rx_frame_after_coarse[FRAME_LENGTH], complex_t rx_frame_after_fine[FRAME_LENGTH]) {
    // Compute the complex conjugate product for fine CFO estimation
    complex_t prod_consq_frame_fine = 0.0;
    for (int i = 0; i < Short_preamble_slot_length * 4; i++) {
        prod_consq_frame_fine += rx_frame_after_coarse[Short_preamble_slot_length * 12 + i] *conjf(rx_frame_after_coarse[Short_preamble_slot_length * 16 + i]);
    }

    // Estimate fine frequency offset
    data_t freq_fine_est = (-1.0 / (2.0 * M_PI * 64 * ts_sec)) * atan2f(cimagf(prod_consq_frame_fine), crealf(prod_consq_frame_fine));

    // Apply fine frequency offset correction
    for (int i = 0; i < FRAME_LENGTH; i++) {
        rx_frame_after_fine[i] = rx_frame_after_coarse[i] * cexpf(-1.0 * I * 2.0 * M_PI * freq_fine_est * ts_sec * i);
    }
}

void channel_estimation(complex_t *rx_frame_after_fine, complex_t *H_est_time) {

	complex_t Long_preamble_1[N_FFT], Long_preamble_2[N_FFT];

    for (int i = 0; i < N_FFT; i++) {
        Long_preamble_1[i] = rx_frame_after_fine[Short_preamble_slot_length * 12 + i];
        Long_preamble_2[i] = rx_frame_after_fine[Short_preamble_slot_length * 16 + i];
    }

    fft(Long_preamble_1);
    fft(Long_preamble_2);
    fftshift(Long_preamble_1);
    fftshift(Long_preamble_2);

    for (int i = 0; i < N_FFT; i++) {
    	H_est_time[i] = 0.5 * (Long_preamble_1[i] + Long_preamble_2[i]) * conjf(Long_preamble_slot_Frequency[i]);
    }
}

void one_tap_equalizer( complex_t *rx_frame_after_fine, complex_t *H_est, complex_t *equalized_1, complex_t *equalized_2) {

	complex_t RX_Payload_1_time[FRAME_SIZE];
    complex_t RX_Payload_1_no_CP[N_FFT];

    complex_t RX_Payload_2_time[FRAME_SIZE];
    complex_t RX_Payload_2_no_CP[N_FFT];

    // Extract first payload frame
    for (int i = 0; i < FRAME_SIZE; i++) {
        RX_Payload_1_time[i] = rx_frame_after_fine[320 + i];
        RX_Payload_2_time[i] = rx_frame_after_fine[400 + i];
    }

    // Remove cyclic prefix
    for (int i = 0; i < N_FFT; i++) {
        RX_Payload_1_no_CP[i] = RX_Payload_1_time[CP_LENGTH + i];
        RX_Payload_2_no_CP[i] = RX_Payload_2_time[CP_LENGTH + i];
    }

    // Apply FFT and shift
    fft(RX_Payload_1_no_CP);
    fftshift(RX_Payload_1_no_CP);

    // Apply FFT and shift
    fft(RX_Payload_2_no_CP);
    fftshift(RX_Payload_2_no_CP);

    // Apply equalization
    for (int i = 0; i < N_FFT; i++) {
        equalized_1[i] = RX_Payload_1_no_CP[i] / H_est[i];
        equalized_2[i] = RX_Payload_2_no_CP[i] / H_est[i];
    }
}

void extract_payload(complex_t *equalized,complex_t *payload) {

    for(int i = 6;i <=10;i++) {
        payload[i-6] = equalized[i];
    }

    for(int i = 12;i <=24;i++) {
        payload[i-7] = equalized[i];
    }

    for(int i = 26;i <=31;i++) {
        payload[i-8] = equalized[i];
    }

    // 33 to 38
    for(int i = 33;i <=38;i++) {
        payload[i-9] = equalized[i];
    }

    // 40 to 52
    for(int i = 40;i <=52;i++) {
        payload[i-10] = equalized[i];
    }

    // 54 to 58
    for(int i = 54;i <=58;i++) {
        payload[i-11] = equalized[i];
    }
}

// Generalized AGC Function for Rx Data Payload
void AGC_Rx_Data_Payload(complex_t *RX_Payload_no_pilot, complex_t *RX_Payload_Final) {

    const data_t scale = 0.707;

    for (int idx = 0; idx < SIZE; idx++) {
        const data_t real_part = crealf(RX_Payload_no_pilot[idx]);
        const data_t imag_part = cimagf(RX_Payload_no_pilot[idx]);

        // Simplified conditional statements
        RX_Payload_Final[idx] = (real_part > 0 ? scale : real_part < 0 ? -scale : 0) + (imag_part > 0 ? scale : imag_part < 0 ? -scale : 0) * I;
    }
}


// Function for QPSK Demodulation
void QPSK_Demodulate(complex_t *RX_Payload_Final, data_t *RX_Payload_Demod) {
    for (int i = 0; i < SIZE; i++) {
        const data_t real_part = crealf(RX_Payload_Final[i]);
        const data_t imag_part = cimagf(RX_Payload_Final[i]);

        // Simplified conditional statements
        if (real_part > 0 && imag_part > 0) {
            RX_Payload_Demod[2 * i] = 0;
            RX_Payload_Demod[2 * i + 1] = 0;
        } else if (real_part < 0 && imag_part > 0) {
            RX_Payload_Demod[2 * i] = 0;
            RX_Payload_Demod[2 * i + 1] = 1;
        } else if (real_part < 0 && imag_part < 0) {
            RX_Payload_Demod[2 * i] = 1;
            RX_Payload_Demod[2 * i + 1] = 0;
        } else if (real_part > 0 && imag_part < 0) {
            RX_Payload_Demod[2 * i] = 1;
            RX_Payload_Demod[2 * i + 1] = 1;
        }
    }
}

// Function for EVM Calculation (Generalized for both before and after AGC)
data_t calculate_evm_agc(complex_t *RX_Payload_1, complex_t *RX_Payload_2, complex_t *data_payload_1_mod, complex_t *data_payload_2_mod) {

	data_t error_rms = 0.0;
    data_t transmitted_rms = 0.0;

    for (int i = 0; i < SIZE; i++) {
    	complex_t error_1 = RX_Payload_1[i] - data_payload_1_mod[i];
    	complex_t error_2 = RX_Payload_2[i] - data_payload_2_mod[i];

    	error_rms = error_rms + crealf(error_1 * conjf(error_1)) + crealf(error_2 * conjf(error_2));
    	transmitted_rms = transmitted_rms + crealf(data_payload_1_mod[i] * conjf(data_payload_1_mod[i])) + crealf(data_payload_2_mod[i] * conjf(data_payload_2_mod[i]));
    }

    data_t evm = sqrtf(error_rms) / sqrtf(transmitted_rms);

    data_t temp = 20 * log10f(evm);

    if (temp == -INFINITY){
    	temp = -40;
    }

    // Return the EVM in dB
    return temp;

}

// Function for BER Calculation
data_t calculate_ber(data_t *data_payload_1, data_t *RX_Payload_1_demod, data_t *data_payload_2, data_t *RX_Payload_2_demod) {

	int errors = 0;

    for (int i = 0; i < 2 * SIZE; i++) {
    	if (fabsf(data_payload_1[i] - RX_Payload_1_demod[i]) > 0 || fabsf(data_payload_2[i] - RX_Payload_2_demod[i]) > 0) {
    	    errors++;
    	}
    }

    data_t temp = (data_t)errors / (4 * SIZE);

    if (temp == 0.0){
    	temp = 0.000001;
    }
    return temp;
}

