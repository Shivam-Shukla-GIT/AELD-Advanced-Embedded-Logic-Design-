//////////////////////////// Functions to implement FFT, IFFT, FFTSHIFT and IFFTSHIFT//////////////////////////
// Function to perform FFT using Cooley-Tukey algorithm
void fft(complex_t *x) {
    int i, j, k, m;
    for (i = 1, j = 0; i < N_FFT; i++) {
        int bit = N_FFT >> 1;
        while (j >= bit) {
            j -= bit;
            bit >>= 1;
        }
        j += bit;
        if (i < j) {
            complex_t temp = x[i];
            x[i] = x[j];
            x[j] = temp;
        }
    }

    for (m = 2; m <= N_FFT; m <<= 1) {
        data_t angle = -2.0 * M_PI / m;
        complex_t w_m = cosf(angle) + sinf(angle) * I;
        for (k = 0; k < N_FFT; k += m) {
            complex_t w = 1.0;
            for (j = 0; j < m / 2; j++) {
                complex_t t = w * x[k + j + m / 2];
                complex_t u = x[k + j];
                x[k + j] = u + t;
                x[k + j + m / 2] = u - t;
                w *= w_m;
            }
        }
    }
}

// Function to perform IFFT
void ifft(complex_t *X) {
    for (int i = 0; i < N_FFT; i++) {
        X[i] = conjf(X[i]);
    }
    fft(X);
    for (int i = 0; i < N_FFT; i++) {
        X[i] = conjf(X[i]) / N_FFT;
    }
}

// Function to perform FFT shift
void fftshift(complex_t *X) {
    int k = N_FFT / 2;
    for (int i = 0; i < k; i++) {
        complex_t temp = X[i];
        X[i] = X[i + k];
        X[i + k] = temp;
    }
}

// Function to perform channel estimation
void ifftshift(complex_t *X) {
    int k = N_FFT / 2;
    for (int i = 0; i < k; i++) {
        complex_t temp = X[i];
        X[i] = X[i + k];
        X[i + k] = temp;
    }
}
