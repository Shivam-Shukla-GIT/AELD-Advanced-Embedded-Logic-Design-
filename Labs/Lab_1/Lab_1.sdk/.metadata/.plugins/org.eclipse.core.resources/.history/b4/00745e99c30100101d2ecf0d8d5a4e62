8797 + 1.47196014438797*I, 0.00000000000000 + 0.00000000000000*I, 0.00000000000000 + 0.00000000000000*I};

	// Initialize Short Preamble Slot Frequency to zero
	complex_t Short_preamble_slot_Frequency[N_FFT];

    // Adding Virtual Carriers in the start and end of short preamble seq.
    for (int i = 0; i < N_FFT; i++) {
        if (i < 6) {
            Short_preamble_slot_Frequency[i] = virtual_subcarrier[i];
        } else if (i < 59) {
            Short_preamble_slot_Frequency[i] = S_k[i - 6];
