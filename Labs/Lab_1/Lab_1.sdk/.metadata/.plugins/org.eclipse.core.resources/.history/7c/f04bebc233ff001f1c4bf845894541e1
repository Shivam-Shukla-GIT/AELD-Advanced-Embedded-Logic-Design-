data_t tx_mean_power(complex_t Tx_signal[TX_SIG_LEN]) {
	data_t power = 0.0;
    for (int i = 0; i < TX_SIG_LEN; i++) {
        power += crealf(Tx_signal[i] * conjf(Tx_signal[i]));
    }
    return power / TX_SIG_LEN;
}

void add_noise(data_t snr_dB, data_t tx_signal_power, complex_t Tx_signal[TX_SIG_LEN], complex_t rx_signal[TX_SIG_LEN]) {

	// Convert SNR from dB to linear scale
    data_t snr_linear = powf(10.0, snr_dB / 10.0);

    // Compute noise power and its standard deviation
    data_t noise_power = tx_signal_power / snr_linear;
    data_t noise_std_dev = sqrtf(noise_power);

    for (int i = 0; i < TX_SIG_LEN; i++) {
        // Generate two independent uniform random numbers in (0,1]
        data_t gaussian1 = ((data_t)rand() + 1.0) / ((data_t)RAND_MAX + 1.0);
        data_t gaussian2 = ((data_t)rand() + 1.0) / ((data_t)RAND_MAX + 1.0);

        // Add noise to the transmitted signal to form the received signal
        rx_signal[i] = Tx_signal[i] + noise_std_dev * (gaussian1 + gaussian2 * I);
    }
    printf("Noise Power %f\n", noise_power);
}

