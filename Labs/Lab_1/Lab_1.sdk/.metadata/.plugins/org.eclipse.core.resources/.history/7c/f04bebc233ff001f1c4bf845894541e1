// Generalized AGC Function for Rx Data Payload
void AGC_Rx_Data_Payload(complex_t *RX_Payload_no_pilot, complex_t *RX_Payload_Final) {
    const data_t scale = 1.0 / sqrt(2);

    for (int idx = 0; idx < SIZE; idx++) {
        const data_t real_part = creal(RX_Payload_no_pilot[idx]);
        const data_t imag_part = cimag(RX_Payload_no_pilot[idx]);

        // Simplified conditional statements
        RX_Payload_Final[idx] = (real_part > 0 ? scale : real_part < 0 ? -scale : 0) +
                                  (imag_part > 0 ? scale : imag_part < 0 ? -scale : 0) * I;
    }
}


// Function for QPSK Demodulation
void QPSK_Demodulate(complex_t *RX_Payload_Final, int *RX_Payload_Demod) {
    for (int i = 0; i < SIZE; i++) {
        const data_t real_part = creal(RX_Payload_Final[i]);
        const data_t imag_part = cimag(RX_Payload_Final[i]);

        // Simplified conditional statements
        if (real_part > 0 && imag_part > 0) {
            RX_Payload_Demod[2 * i] = 0;
            RX_Payload_Demod[2 * i + 1] = 0;
        } else if (real_part < 0 && imag_part > 0) {
            RX_Payload_Demod[2 * i] = 0;
            RX_Payload_Demod[2 * i + 1] = 1;
        } else if (real_part < 0 && imag_part < 0) {
            RX_Payload_Demod[2 * i] = 1;
            RX_Payload_Demod[2 * i + 1] = 0;
        } else {
            RX_Payload_Demod[2 * i] = 1;
            RX_Payload_Demod[2 * i + 1] = 1;
        }
    }
}

// Function for EVM Calculation (Generalized for both before and after AGC)
data_t calculate_evm_agc(complex_t *RX_Payload_1, complex_t *RX_Payload_2, complex_t *data_payload_1_mod, complex_t *data_payload_2_mod) {
    data_t error_rms = 0.0;
    data_t transmitted_rms = 0.0;

    for (int i = 0; i < SIZE; i++) {
        const data_t error_real_1 = crealf(RX_Payload_1[i] - data_payload_1_mod[i]);
        const data_t error_imag_1 = cimagf(RX_Payload_1[i] - data_payload_1_mod[i]);
        const data_t error_real_2 = crealf(RX_Payload_2[i] - data_payload_2_mod[i]);
        const data_t error_imag_2 = cimagf(RX_Payload_2[i] - data_payload_2_mod[i]);

        error_rms += error_real_1 * error_real_1 + error_imag_1 * error_imag_1 + error_real_2 * error_real_2 + error_imag_2 * error_imag_2;

        const data_t transmitted_real_1 = crealf(data_payload_1_mod[i]);
        const data_t transmitted_imag_1 = cimagf(data_payload_1_mod[i]);
        const data_t transmitted_real_2 = crealf(data_payload_2_mod[i]);
        const data_t transmitted_imag_2 = cimagf(data_payload_2_mod[i]);

        transmitted_rms += transmitted_real_1 * transmitted_real_1 + transmitted_imag_1 * transmitted_imag_1 + transmitted_real_2 * transmitted_real_2 + transmitted_imag_2 * transmitted_imag_2;
    }

     error_rms = sqrt(error_rms / (2 * SIZE));
    transmitted_rms = sqrt(transmitted_rms / (2 * SIZE));

    // Calculate EVM
    data_t evm = error_rms / transmitted_rms;
    printf("inside evm : %f, log lene ke baad evm: %f\n", evm, 20*log10(evm));

    // Define a small threshold for floating-point comparison
    data_t epsilon = 0.0001;  // A small threshold value

    // Check if EVM is close enough to zero
    if (fabs(evm) < epsilon) {
        return -INFINITY;  // Return -INFINITY for the case where evm is very close to zero
    }
    // Return the EVM in dB
    return 20 * log10(evm);
}

// Function for BER Calculation
data_t calculate_ber(data_t *data_payload_1, data_t *RX_Payload_1_demod, data_t *data_payload_2, data_t *RX_Payload_2_demod) {
    int errors = 0;


    for (int i = 0; i < 2 * SIZE; i++) {
        if (fabs(data_payload_1[i] - RX_Payload_1_demod[i]) > 0) {
            errors++;
        }
        if (fabs(data_payload_2[i] - RX_Payload_2_demod[i]) > 0) {
            errors++;
        }
    }
    printf("inside BER errors : %d\n", errors);
    return (data_t) errors / (4 * SIZE);
}


