void packet_detection(complex_t Rx_signal[PACKETS_CAPTURE_LEN], data_t corr_out[corr_arr_len]){

    for (int n = 0; n < corr_arr_len; n++) {
    	complex_t temp1 = 0.0 + 0.0*I;
    	data_t temp2 = 0.0;
    	for (int k = 0; k < window_length; k++) {
    		temp1 += Rx_signal[n+k]*Rx_signal[n+k+delay_param];
    		temp2 += crealf(Rx_signal[n+k+delay_param] * conjf(Rx_signal[n+k+delay_param]));
    	}
    	corr_out[n] = (crealf(temp1 * conjf(temp1)))/(temp2*temp2);
    }
}

void packet_selection_and_downsampling(complex_t rx_frame[frame_size],data_t corr_out[corr_arr_len],complex_t Rx_filter_signal[rrc_rc_out_len]){

	data_t packet_threshold = 0.75;

	int temp_packet_idx_arr[corr_arr_len] = {0};
    int idx_count = 0;

    for (int i = 0; i < corr_arr_len; i++) {
        if (corr_out[i] > packet_threshold) {
        	temp_packet_idx_arr[idx_count] = i;
        	idx_count += 1;
        }
    }

    int packet_idx_arr[idx_count];

    for (int i = 0; i < idx_count; i++) {
        packet_idx_arr[i] = temp_packet_idx_arr[i];
    }

    int temp3[idx_count + 1];


    // Compute the first element
    temp3[0] = packet_idx_arr[0];

    // Compute differences for the middle elements
    for (int i = 1; i < idx_count; i++) {
    	temp3[i] = packet_idx_arr[i] - packet_idx_arr[i - 1];
    }
    // Compute the last element
    temp3[idx_count] = -packet_idx_arr[idx_count - 1];

    int temp_packet_front[idx_count+1];
    int packet_front_count = 0;
    for (int i = 0; i < idx_count+1; i++) {
    	if (temp3[i] > 300) {
    		temp_packet_front[packet_front_count] = i;
    		packet_front_count += 1;
        	}
    	else{
    		temp_packet_front[i] = 0;
    	}
        }
    int packet_front[packet_front_count];
    for (int i = 0; i < packet_front_count; i++) {
    	packet_front[i] = temp_packet_front[i];
    }

    int packet_front_idx[packet_front_count];
    for (int i = 0; i < packet_front_count; i++) {
        packet_front_idx[i] = packet_idx_arr[packet_front[i]];
    }

    int threshold_length = 230; // Minimum length of the packet
    int packet_idx = 0;
    for (int x = 0; x < packet_front_count - 1; x++) {
    	if (corr_out[packet_front_idx[x] + threshold_length] > packet_threshold) {
    		packet_idx = packet_front_idx[x] + length_rrc_rx + 1;  // Adjust for RRC filter delay
    		break;  // Exit loop once a valid packet is found
    		}
    }

    int end_idx = oversampling_rate_rx * frame_size + packet_idx - 1;
    int j = 0;

    // Loop to extract values at the specified step
    for (int i = packet_idx; i <= end_idx; i += oversampling_rate_rx) {
    	rx_frame[j++] = Rx_filter_signal[i];
        }
}

void coarse_cfo_estimation(complex_t rx_frame[frame_size], complex_t rx_frame_after_coarse[frame_size]) {

    // Compute the complex conjugate product
    complex_t prod_consq_frame_coarse = 0.0 + 0.0 * I;
    for (int i = 0; i < Short_preamble_length; i++) {
        prod_consq_frame_coarse += rx_frame[5 * Short_preamble_length + i] * conjf(rx_frame[6 * Short_preamble_length + i]);
    }

    // Estimate the coarse frequency offset
    data_t freq_coarse_est = (-1.0 / (2.0 * PI * Short_preamble_length * ts_sec)) *atan2f(cimagf(prod_consq_frame_coarse), crealf(prod_consq_frame_coarse));

    // Apply CFO correction to the received frame
    for (int i = 0; i < frame_size; i++) {
    	data_t phase_shift = -2.0 * PI * freq_coarse_est * ts_sec * i;
        rx_frame_after_coarse[i] = rx_frame[i] * cexpf(I * phase_shift);
    }
}

void fine_cfo_estimation(complex_t rx_frame_after_coarse[frame_size], complex_t rx_frame_after_fine[frame_size]) {
    // Compute the complex conjugate product for fine CFO estimation

	complex_t prod_consq_frame_fine = 0.0;
    for (int i = 0; i < N; i++) {
        prod_consq_frame_fine += rx_frame_after_coarse[Short_preamble_length * 12 + i] *conj(rx_frame_after_coarse[Short_preamble_length * 16 + i]);
    }

    // Estimate fine frequency offset
    data_t freq_fine_est = (-1.0 / (2.0 * PI * N * ts_sec)) * atan2f(cimagf(prod_consq_frame_fine), crealf(prod_consq_frame_fine));

    // Apply fine frequency offset correction
    for (int i = 0; i < frame_size; i++) {
        rx_frame_after_fine[i] = rx_frame_after_coarse[i] * cexpf(-1.0 * I * 2.0 * PI * freq_fine_est * ts_sec * i);
    }
}


// Function to perform FFT using Cooley-Tukey algorithm
void fft(complex_t *x) {
    int i, j, k, m;
    for (i = 1, j = 0; i < N; i++) {
        int bit = N >> 1;
        while (j >= bit) {
            j -= bit;
            bit >>= 1;
        }
        j += bit;
        if (i < j) {
            complex_t temp = x[i];
            x[i] = x[j];
            x[j] = temp;
        }
    }
    for (m = 2; m <= N; m <<= 1) {
        data_t angle = -2.0 * PI / m;
        complex_t w_m = cosf(angle) + sinf(angle) * I;
        for (k = 0; k < N; k += m) {
        	complex_t w = 1.0;
            for (j = 0; j < m / 2; j++) {
                complex_t t = w * x[k + j + m / 2];
                complex_t u = x[k + j];
                x[k + j] = u + t;
                x[k + j + m / 2] = u - t;
                w *= w_m;
            }
        }
    }
}

// Function to perform IFFT
void ifft(complex_t *X) {
    for (int i = 0; i < N; i++) {
        X[i] = conjf(X[i]);
    }
    fft(X);
    for (int i = 0; i < N; i++) {
        X[i] = conjf(X[i]) / N;
    }
}

// Function to perform FFT shift
void fftshift(complex_t *X, int n) {
    int k = n / 2;
    for (int i = 0; i < k; i++) {
        complex_t temp = X[i];
        X[i] = X[i + k];
        X[i + k] = temp;
    }
}

// Function to perform channel estimation
void ifftshift(complex_t *X, int n) {
    int k = n / 2;
    for (int i = 0; i < k; i++) {
        complex_t temp = X[i];
        X[i] = X[i + k];
        X[i + k] = temp;
    }
}

// Function to perform channel estimation
void channel_estimation(complex_t *rx_frame_after_fine, complex_t *Long_preamble_slot_Frequency, complex_t *H_est_time) {
    complex_t Long_preamble_1[N], Long_preamble_2[N];

    for (int i = 0; i < N; i++) {
        Long_preamble_1[i] = rx_frame_after_fine[Short_preamble_length * 12 + i];
        Long_preamble_2[i] = rx_frame_after_fine[Short_preamble_length * 16 + i];
    }

    fft(Long_preamble_1);
    fft(Long_preamble_2);
    fftshift(Long_preamble_1, N);
    fftshift(Long_preamble_2, N);

    for (int i = 0; i < N; i++) {
    	H_est_time[i] = 0.5 * (Long_preamble_1[i] + Long_preamble_2[i]) * conjf(Long_preamble_slot_Frequency[i]);
    }
}

void one_tap_equalizer(
    complex_t *rx_frame_after_fine,
    complex_t *H_est,
    complex_t *equalized_1,
    complex_t *equalized_2
) {
    complex_t RX_Payload_1_time[frame_size];
    complex_t RX_Payload_1_no_CP[N];

    complex_t RX_Payload_2_time[frame_size];
    complex_t RX_Payload_2_no_CP[N];

    // Extract first payload frame
    for (int i = 0; i < frame_size; i++) {
        RX_Payload_1_time[i] = rx_frame_after_fine[320 + i];
    }

    // Remove cyclic prefix
    for (int i = 0; i < N; i++) {
        RX_Payload_1_no_CP[i] = RX_Payload_1_time[CP_SIZE + i];
    }

    // Apply FFT and shift
    fft(RX_Payload_1_no_CP);
    fftshift(RX_Payload_1_no_CP, N);

    // Apply equalization
    for (int i = 0; i < N; i++) {
        equalized_1[i] = RX_Payload_1_no_CP[i] / H_est[i];
    }

    // Extract second payload frame
    for (int i = 0; i < frame_size; i++) {
        RX_Payload_2_time[i] = rx_frame_after_fine[400 + i];
    }

    // Remove cyclic prefix
    for (int i = 0; i < N; i++) {
        RX_Payload_2_no_CP[i] = RX_Payload_2_time[CP_SIZE + i];
    }

    // Apply FFT and shift
    fft(RX_Payload_2_no_CP);
    fftshift(RX_Payload_2_no_CP, N);

    // Apply equalization
    for (int i = 0; i < N; i++) {
        equalized_2[i] = RX_Payload_2_no_CP[i] / H_est[i];
    }
}

