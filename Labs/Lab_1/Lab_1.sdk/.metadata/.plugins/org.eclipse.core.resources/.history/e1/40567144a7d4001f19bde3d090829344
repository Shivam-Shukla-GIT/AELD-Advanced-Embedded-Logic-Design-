/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"


int main()
{
    init_platform();

    	float X[3], N[3], T[3]; // input vectors
        float Q[3]; // output vector
        int i;

        // Taking the vector as input for all the input variables
        printf("\nTaking the input for vector X: \n");
        for(i=0; i<3; i++)
        {
            printf("Enter the vector X[%d] : \n", i);
            scanf("%f", &X[i]);
        }

        printf("\nTaking the input for vector N: \n");
        for(i=0; i<3; i++) {
            printf("Enter the vector N[%d] : \n", i);
            scanf("%f", &N[i]);
        }

        printf("\nTaking the input for vector T: \n");
        for(i=0; i<3; i++) {
            printf("Enter the vector T[%d] : \n", i);
            scanf("%f", &T[i]);
        }

        // Printing the input vectors
        printf("\n--------------------------------\n");
        printf("Vector X is : \n");
        for(i=0; i<3; i++) {
            printf("%f\t", X[i]);
        }

        printf("\n--------------------------------");
        printf("\nVector N is : \n");
        for(i=0; i<3; i++) {
            printf("%f\t", N[i]);
        }

        printf("\n--------------------------------");
        printf("\nVector T is : \n");
        for(i=0; i<3; i++) {
            printf("%f\t", T[i]);
        }

        // Doing the Mathematic operation
        for(i=0; i<3; i++) {
        	Q[i] = (X[i]/T[i]) + sqrtf((2*N[i])/T[i]);
        }

        // Printing the output vectors
        printf("\n--------------------------------");
        printf("\nThe output Vector Q is : \n");
        for(i=0; i<3; i++) {
            printf("%f\t", Q[i]);
        }


    cleanup_platform();
    return 0;
}

