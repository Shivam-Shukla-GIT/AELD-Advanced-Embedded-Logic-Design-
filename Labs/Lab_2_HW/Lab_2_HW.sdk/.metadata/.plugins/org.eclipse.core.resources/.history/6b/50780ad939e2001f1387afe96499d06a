void FIR_PS_Sym_Float(int FIR_Size, float FIR_COEFF[], float FIR_input[], float FIR_output[]) {
    int index1, index2;
    float shift_reg[FIR_Size];

    // Initialize the shift register to zero
    for (index1 = 0; index1 < FIR_Size; index1++) {
        shift_reg[index1] = 0;
    }

    // Process each input sample
    for (index1 = 0; index1 < FIR_Data_Size; index1++) {
        // Shift the register values
        for (index2 = FIR_Size - 1; index2 > 0; index2--) {
            shift_reg[index2] = shift_reg[index2 - 1];
        }
        // Insert the new input sample into the shift register
        shift_reg[0] = FIR_input[index1];

        // Initialize the FIR output for the current input
        FIR_output[index1] = 0;

        // Calculate the symmetric convolution
        for (index2 = 0; index2 < FIR_Size / 2; index2++) {
            FIR_output[index1] += (shift_reg[index2] + shift_reg[FIR_Size - index2 - 1]) * FIR_COEFF[index2];
        }

        // Handle the middle coefficient for odd-sized filters
        if (FIR_Size % 2 == 1) {
            FIR_output[index1] += shift_reg[FIR_Size / 2] * FIR_COEFF[FIR_Size / 2];
        }
    }
}


// Measure execution time for int FIR filters
void Time_Int(const char *filter_name, void (*FIR_function)(int, int[], int[], int[]), int FIR_COEFF[], int FIR_Size)
{
    int FIR_input[FIR_Data_Size];
    int FIR_output[FIR_Data_Size];
    XTime time_PS_start, time_PS_end;

    // Generate sine wave input
    for (int i = 0; i < FIR_Data_Size; i++) {
        FIR_input[i] = i+1;
    }

    // Measure execution time
    XTime_GetTime(&time_PS_start);
    FIR_function(FIR_Size, FIR_COEFF, FIR_input, FIR_output);
    XTime_GetTime(&time_PS_end);

    // Print results
    printf("\n%s Filter (Size = %d):\n", filter_name, FIR_Size);
    printf("FIR output : \n");
    for (int index = 0 ; index < FIR_Data_Size ; index++)
    {
        printf("%d\n", FIR_output[index]);
    }
    printf("\nExecution Time: %.2f microseconds\n", 1.0 * (time_PS_end - time_PS_start) / (COUNTS_PER_SECOND / 1000000));
    printf("\n------------------------------\n");
}

// Measure execution time for float FIR filters
void Time_Float(const char *filter_name, void (*FIR_function)(int, float[], float[], float[]), float FIR_COEFF[], int FIR_Size)
{
    float FIR_input[FIR_Data_Size];
    float FIR_output[FIR_Data_Size];
    XTime time_PS_start, time_PS_end;

    // Generate sine wave input
    for (int i = 0; i < FIR_Data_Size; i++) {
        FIR_input[i] = (float)(i+1);
    }

    // Measure execution time
    XTime_GetTime(&time_PS_start);
    FIR_function(FIR_Size, FIR_COEFF, FIR_input, FIR_output);
    XTime_GetTime(&time_PS_end);

    // Print results
    printf("\n%s Filter (Size = %d):\n", filter_name, FIR_Size);
    printf("FIR output : \n");
    for (int index = 0 ; index < FIR_Data_Size ; index++)
    {
        printf("%f\n", FIR_output[index]);
    }
    printf("\nExecution Time: %.2f microseconds\n", 1.0 * (time_PS_end - time_PS_start) / (COUNTS_PER_SECOND / 1000000));
    printf("\n------------------------------\n");
}

int main()
{
//    init_platform();
	Xil_ICacheDisable();
    // Compare execution times for integer FIR filters
    printf("\n--- Integer FIR Filter Execution ---\n");
    Time_Int("Unoptimized", FIR_PS_Direct, FIR_COEFF_1, FIR_Size_1);
    Time_Int("Bit Optimized", FIR_PS_Direct1, FIR_COEFF_1, FIR_Size_1);
    Time_Int("Symmetry Optimized", FIR_PS_Sym, FIR_COEFF_1, FIR_Size_1);


    Time_Int("Unoptimized", FIR_PS_Direct, FIR_COEFF_2, FIR_Size_2);
    Time_Int("Bit Optimized", FIR_PS_Direct1, FIR_COEFF_2, FIR_Size_2);
    Time_Int("Symmetry Optimized", FIR_PS_Sym, FIR_COEFF_2, FIR_Size_2);

    // Compare execution times for float FIR filters
    printf("\n--- Float FIR Filter Execution ---\n");
    Time_Float("Unoptimized", FIR_PS_Direct_Float, FIR_COEFF_1_Float, FIR_Size_1);
    Time_Float("Bit Optimized", FIR_PS_Direct1_Float, FIR_COEFF_1_Float, FIR_Size_1);
    Time_Float("Symmetry Optimized", FIR_PS_Sym_Float, FIR_COEFF_1_Float, FIR_Size_1);


    Time_Float("Unoptimized", FIR_PS_Direct_Float, FIR_COEFF_2_Float, FIR_Size_2);
    Time_Float("Bit Optimized", FIR_PS_Direct1_Float, FIR_COEFF_2_Float, FIR_Size_2);
    Time_Float("Symmetry Optimized", FIR_PS_Sym_Float, FIR_COEFF_2_Float, FIR_Size_2);

//    cleanup_platform();
    return 0;
}

